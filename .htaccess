ErrorDocument 404 /404.html
Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
 RewriteEngine On
 RewriteCond %{HTTP_HOST} ^www\.visas\.com\.py$ [NC]
 RewriteRule ^ https://visas.com.py%{REQUEST_URI} [R=301,L]
 RewriteCond %{HTTPS} !=on
 RewriteCond %{HTTP_HOST} ^visas\.com\.py$ [NC]
 RewriteRule ^ https://visas.com.py%{REQUEST_URI} [R=301,L]
 RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[?\s] [NC]
 RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
 RewriteCond %{REQUEST_FILENAME} -d
 RewriteRule ^(.+[^/])$ /$1/ [R=301,L]
 RewriteRule ^(?:lib|scripts|tests|docs|deploy|node_modules|\.git)(?:/|$) - [F,L,NC]
</IfModule>
<IfModule mod_headers.c>
 Header always set X-Content-Type-Options "nosniff"
 Header always set Referrer-Policy "strict-origin-when-cross-origin"
 Header always set X-Frame-Options "SAMEORIGIN"
 Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
 Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
 Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
 <FilesMatch "\.(css|js|svg|avif|webp|png|jpg|woff2)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
 </FilesMatch>
 <FilesMatch "\.html$">
  Header set Cache-Control "no-cache"
 </FilesMatch>
</IfModule>
<FilesMatch "(^\.|\.(log|ini|sql|bak|mjs|md|lock)$|^(package.*\.json|config.*\.php|manifest\.json)$)">
 Require all denied
</FilesMatch>
<IfModule mod_mime.c>
 AddType image/avif .avif
 AddType image/webp .webp
</IfModule>
